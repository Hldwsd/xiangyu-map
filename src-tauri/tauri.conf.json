{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "乡遇安徽",
  "version": "0.1.0",
  "identifier": "com.xiangyu.anhui",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173/brand/index.html",
    "beforeBuildCommand": "pnpm build-only --base=/",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "乡遇安徽",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "url": "brand/index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "template": "nsis/installer.nsi",
        "startMenuFolder": "乡遇安徽"
      }
    }
  }
}
